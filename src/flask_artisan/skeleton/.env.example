APP_NAME=
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=UTC

# `flask run` lit FLASK_DEBUG : il suit APP_DEBUG, ne changez que APP_DEBUG.
FLASK_DEBUG=${APP_DEBUG}

# Nombre de proxys devant l'app (nginx, load balancer) ; 0 sans proxy.
# TRUSTED_PROXIES=1

# Base de données : sqlite (par défaut), mysql, mariadb ou pgsql.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=blog
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=postgresql+psycopg://user:pass@host/db

# Mail : log (écrit dans les logs), smtp ou array (gardé en mémoire).
MAIL_MAILER=log
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls        # tls (port 587), ssl (port 465) ou vide
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="${APP_NAME}"

# Files d'attente : sync (exécution immédiate) ou redis (worker : flask queue:work).
QUEUE_CONNECTION=sync
# REDIS_URL=redis://127.0.0.1:6379/0

# Cache : file (dossier storage/cache), array (mémoire) ou redis (REDIS_URL).
CACHE_STORE=file
# CACHE_PREFIX=monapp_cache:

# Fichiers : local (storage/app/private), public (servi par /storage) ou s3.
FILESYSTEM_DISK=local
# AWS_BUCKET=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT=              # MinIO, R2… ; vide pour AWS
# AWS_URL=                   # CDN devant le bucket
