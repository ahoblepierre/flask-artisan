{% extends "layouts/app.html" %}

{% block title %}Vérifiez votre e-mail{% endblock %}

{% block content %}
<h1>Vérifiez votre e-mail</h1>
<p>Un lien de vérification vous a été envoyé par e-mail. Ouvrez-le pour activer votre compte.</p>
<form method="post" action="{{ url_for('verification.send') }}">
    {{ csrf_field() }}
    <button type="submit">Renvoyer le lien</button>
</form>
{% endblock %}
