from app.http.requests.reset_password_request import ResetPasswordRequest
from flask import flash, redirect, render_template, request, url_for

from flask_artisan.auth.passwords import Password
from flask_artisan.validation import ValidationError


class NewPasswordController:
    """Lien reçu par e-mail : choisir un nouveau mot de passe."""

    def create(self, token: str):
        return render_template(
            "auth/reset_password.html", token=token, email=request.args.get("email", "")
        )

    def store(self, request: ResetPasswordRequest):
        data = request.validated()
        status = Password.reset(data["email"], data["token"], data["password"])
        if status != Password.PASSWORD_RESET:
            raise ValidationError(
                {"email": ["Ce lien de réinitialisation est invalide ou a expiré."]}
            )
        flash("Mot de passe réinitialisé : vous pouvez vous connecter.")
        return redirect(url_for("login"))
