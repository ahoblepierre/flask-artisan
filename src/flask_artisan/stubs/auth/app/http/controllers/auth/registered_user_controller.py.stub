from app.http.requests.register_request import RegisterRequest
from app.models.user import User
from flask import current_app, flash, redirect, render_template, url_for

from flask_artisan import Auth
from flask_artisan.auth import MustVerifyEmail


class RegisteredUserController:
    """Inscription : crée le compte, connecte, envoie le lien de vérification."""

    def create(self):
        return render_template("auth/register.html")

    def store(self, request: RegisterRequest):
        data = request.validated()
        user = User.create(name=data["name"], email=data["email"], password=data["password"])
        Auth.login(user)
        flash("Bienvenue !")
        if isinstance(user, MustVerifyEmail):
            try:
                user.send_email_verification_notification()
            except Exception:
                # Le compte existe déjà : l'utilisateur renverra le lien depuis /verify-email.
                current_app.logger.exception("Envoi du lien de vérification impossible")
                flash("Le lien de vérification n'a pas pu être envoyé : renvoyez-le.")
        return redirect(url_for("dashboard"))
