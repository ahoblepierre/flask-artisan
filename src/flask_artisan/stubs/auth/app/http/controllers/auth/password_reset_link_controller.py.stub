from app.http.requests.forgot_password_request import ForgotPasswordRequest
from flask import flash, redirect, render_template, url_for

from flask_artisan.auth.passwords import Password


class PasswordResetLinkController:
    """Mot de passe oublié : envoie le lien de réinitialisation par e-mail."""

    def create(self):
        return render_template("auth/forgot_password.html")

    def store(self, request: ForgotPasswordRequest):
        Password.send_reset_link(request.validated()["email"])
        # Même message que l'adresse ait un compte ou non : on ne révèle pas qui est inscrit.
        flash(
            "Si un compte existe pour cette adresse, un lien de réinitialisation vient "
            "d'être envoyé."
        )
        return redirect(url_for("password.request"))
